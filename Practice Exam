<style>
:root {
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top, 0px);
  padding-bottom:env(safe-area-inset-bottom, 0px);
  --bg:#f5f4f0; --surface:#ffffff; --surface2:#f9f8f5; --border:#e2dfd6; --border2:#d3cfc3;
  --text:#1d1c22; --muted:#6c6b76; --muted2:#4f4e59;
  --accent:#8f6a12; --accent-bg:#8f6a1216;
  --ok:#157a3a; --ok-bg:#15803d12; --ok-line:#16a34a;
  --bad:#b42323; --bad-bg:#dc262610; --bad-line:#dc2626;
  --warn:#a15c07; --warn-bg:#d9770614; --info:#1d4ed8; --info-bg:#2563eb12;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg:#0c0c12; --surface:#14141e; --surface2:#0a0a14; --border:#1e1e2e; --border2:#2a2a3e;
    --text:#e2e8f0; --muted:#64748b; --muted2:#94a3b8;
    --accent:#d4a843; --accent-bg:#d4a84322;
    --ok:#4ade80; --ok-bg:#16532822; --ok-line:#16a34a;
    --bad:#f87171; --bad-bg:#450a0a33; --bad-line:#dc2626;
    --warn:#fbbf24; --warn-bg:#78350f33; --info:#93c5fd; --info-bg:#1e3a8a33;
  }
}
:root[data-theme="dark"] {
  --bg:#0c0c12; --surface:#14141e; --surface2:#0a0a14; --border:#1e1e2e; --border2:#2a2a3e;
  --text:#e2e8f0; --muted:#64748b; --muted2:#94a3b8;
  --accent:#d4a843; --accent-bg:#d4a84322;
  --ok:#4ade80; --ok-bg:#16532822; --ok-line:#16a34a;
  --bad:#f87171; --bad-bg:#450a0a33; --bad-line:#dc2626;
  --warn:#fbbf24; --warn-bg:#78350f33; --info:#93c5fd; --info-bg:#1e3a8a33;
}
*,*::before,*::after { box-sizing:inherit; margin:0; padding:0; -webkit-tap-highlight-color:transparent; }
html { scroll-padding-top:env(safe-area-inset-top, 0px); }
body { background:var(--bg); color:var(--text); font-family:system-ui,-apple-system,"Segoe UI",sans-serif; min-height:100%; }
button { font-family:inherit; }
button:focus-visible { outline:2px solid var(--accent); outline-offset:2px; }

.header { background:var(--surface); border-bottom:1px solid var(--border); padding:14px 14px 10px; position:sticky; top:env(safe-area-inset-top, 0px); z-index:100; }
.wrap { max-width:720px; margin:0 auto; }
.header-top { display:flex; justify-content:space-between; align-items:center; gap:10px; }
.title { font-size:18px; font-weight:800; color:var(--accent); letter-spacing:-0.2px; }
.subtitle { font-size:11px; color:var(--muted); margin-top:2px; }
.stats { display:flex; gap:14px; }
.stat-label { font-size:10px; color:var(--muted); text-align:center; }
.stat-val { font-size:16px; font-weight:800; text-align:center; font-variant-numeric:tabular-nums; }
.filters { display:flex; gap:5px; margin-top:10px; flex-wrap:wrap; align-items:center; }
.fbtn { padding:5px 11px; font-size:11px; font-weight:600; border-radius:14px; cursor:pointer; border:1px solid var(--border2); background:transparent; color:var(--muted2); }
.fbtn.on { border-color:var(--accent); background:var(--accent-bg); color:var(--accent); }
.fbtn.drill { border-color:var(--bad-line); }
.fbtn.drill.on { background:var(--bad-bg); color:var(--bad); }
.fbtn.mock { border-color:var(--info); }
.fbtn.mock.on { background:var(--info-bg); color:var(--info); }
.sbtn { padding:5px 11px; font-size:11px; font-weight:700; border-radius:14px; border:1px solid var(--accent); background:transparent; color:var(--accent); cursor:pointer; }
.rbtn { padding:5px 11px; font-size:11px; font-weight:700; border-radius:14px; border:1px solid var(--bad-line); background:transparent; color:var(--bad); cursor:pointer; }
.rbtn.confirm { background:var(--bad-bg); }

.controls { max-width:720px; margin:0 auto; padding:10px 10px 0; }
.tools { display:flex; gap:6px; flex-wrap:wrap; }
.tbtn { padding:6px 12px; font-size:11px; font-weight:600; border-radius:8px; cursor:pointer; border:1px solid var(--border2); background:var(--surface); color:var(--muted2); }
.tbtn.on { border-color:var(--accent); color:var(--accent); }
.chips { margin-top:8px; display:flex; flex-direction:column; gap:5px; }
.chip-row { display:flex; gap:4px; flex-wrap:wrap; align-items:center; }
.mchip, .secbtn { padding:4px 9px; font-size:11px; font-weight:600; border-radius:12px; cursor:pointer; border:1px solid var(--border2); background:transparent; color:var(--muted2); }
.secbtn { font-weight:800; min-width:34px; }
.mchip.on, .secbtn.on { border-color:var(--accent); background:var(--accent-bg); color:var(--accent); }
.mchip.all.on { border-color:var(--ok-line); background:var(--ok-bg); color:var(--ok); }
.legend { font-size:10px; color:var(--muted); margin-top:8px; line-height:1.6; }
.legend b { font-weight:600; }

.panel { background:var(--surface); border:1px solid var(--border); border-radius:10px; padding:14px; margin-top:10px; font-size:12px; line-height:1.6; color:var(--muted2); }
.panel h3 { font-size:14px; color:var(--text); margin-bottom:8px; }
.panel h4 { font-size:12px; color:var(--accent); margin:12px 0 4px; }
.panel ul { padding-left:18px; }
.panel li { margin-bottom:4px; }
.panel .strong { color:var(--text); font-weight:600; }
.sec-bars { display:flex; flex-direction:column; gap:6px; margin-top:8px; }
.sec-bar { display:grid; grid-template-columns:minmax(0,1fr) 110px; gap:8px; align-items:center; }
.bar { height:8px; border-radius:4px; background:var(--border); overflow:hidden; margin-top:3px; }
.bar > span { display:block; height:100%; }
.status { font-size:10px; font-weight:700; text-align:right; }
.fgrid { display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:4px 16px; }
.frow { padding:3px 0; border-bottom:1px dashed var(--border); }
.frow .strong { display:inline-block; min-width:0; }
.panel-link { margin-top:10px; padding:6px 12px; border-radius:14px; border:1px solid var(--bad-line); background:var(--bad-bg); color:var(--bad); font-weight:700; font-size:11px; cursor:pointer; }

.main { max-width:720px; margin:0 auto; padding:10px 10px 80px; }
.card { background:var(--surface); border-radius:10px; border:1px solid var(--border); margin-bottom:8px; overflow:hidden; }
.card.correct { border-color:var(--ok-line); }
.card.wrong { border-color:var(--bad-line); }
.card-head { padding:10px 12px 6px; }
.tags { display:flex; gap:5px; align-items:center; flex-wrap:wrap; }
.qnum { font-size:10px; font-weight:700; color:var(--muted); }
.tag { font-size:10px; padding:2px 7px; border-radius:8px; font-weight:600; }
.tag-mastered { background:var(--ok-bg); color:var(--ok); }
.tag-needs { background:var(--warn-bg); color:var(--warn); }
.tag-weak { background:var(--bad-bg); color:var(--bad); }
.tag-new { background:var(--info-bg); color:var(--info); }
.tag-m { background:var(--surface2); color:var(--muted2); border:1px solid var(--border); }
.tag-pa { background:var(--bad-bg); color:var(--bad); border:1px solid var(--bad-line); }
.qtext { padding:0 12px 9px; font-size:14px; line-height:1.55; font-weight:500; }
.opts { padding:0 12px 10px; display:flex; flex-direction:column; gap:5px; }
.opt { padding:10px 11px; font-size:13px; text-align:left; border-radius:7px; border:1px solid var(--border); background:var(--surface2); color:var(--text); cursor:pointer; line-height:1.45; width:100%; }
.opt:disabled { cursor:default; }
.opt .letter { font-weight:700; margin-right:6px; color:var(--muted); }
.opt.right { background:var(--ok-bg); border-color:var(--ok-line); color:var(--ok); font-weight:700; }
.opt.right .letter { color:var(--ok); }
.opt.picked-wrong { background:var(--bad-bg); border-color:var(--bad-line); color:var(--bad); }
.opt.dimmed { opacity:0.5; }
.explanation { padding:10px 12px; border-top:1px solid var(--border); background:var(--surface2); font-size:12px; color:var(--muted2); line-height:1.7; }
.verdict { font-size:11px; font-weight:700; margin-right:5px; }
.verdict.ok { color:var(--ok); }
.verdict.no { color:var(--bad); }
.final { text-align:center; padding:24px 18px; background:var(--surface); border-radius:12px; border:2px solid var(--accent); margin-top:8px; }
.final-pct { font-size:44px; font-weight:800; font-variant-numeric:tabular-nums; }
.final-detail { font-size:13px; color:var(--muted2); margin-top:3px; }
.final-msg { font-size:12px; color:var(--muted); margin-top:8px; line-height:1.5; }
.final-secs { margin:14px auto 0; max-width:360px; text-align:left; font-size:12px; color:var(--muted2); }
.final-secs div { display:flex; justify-content:space-between; padding:3px 0; border-bottom:1px dashed var(--border); }
.final-btn { margin-top:14px; padding:8px 18px; border-radius:18px; border:1px solid var(--accent); background:var(--accent-bg); color:var(--accent); cursor:pointer; font-weight:700; font-size:12px; margin-right:6px; }
.empty { text-align:center; padding:30px; color:var(--muted); font-size:13px; line-height:1.6; }
@media (prefers-reduced-motion: reduce) { * { scroll-behavior:auto !important; } }
</style>
